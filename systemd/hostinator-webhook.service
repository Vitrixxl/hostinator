[Unit]
Description=Hostinator GitHub webhook
After=network-online.target docker.service caddy.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vitrix/hostinator
Environment=HOSTINATOR_ENV_FILE=/home/vitrix/hostinator/.env
ExecStart=/usr/local/bin/hostinator-webhook
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
