# Domaine racine. Le webhook CI/CD sera exposé par défaut sur ci-cd.<BASE_DOMAIN>.
BASE_DOMAIN=example.com

# Les repos déployés seront clonés dans ce dossier.
HOSTINATOR_HOME=/home/vitrix/hostinator

# Binaire/CLI appelé par le service webhook.
HOSTINATOR_BIN=/usr/local/bin/hostinator

# Adresse locale de l'API Rust.
HOSTINATOR_WEBHOOK_ADDR=127.0.0.1:7878

# Sous-domaine du webhook CI/CD. Tu peux aussi forcer un domaine complet avec HOSTINATOR_CICD_DOMAIN.
HOSTINATOR_CICD_SUBDOMAIN=ci-cd
# HOSTINATOR_CICD_DOMAIN=deploy.example.com

# Branches GitHub autorisées à déclencher un pull + rebuild.
HOSTINATOR_ALLOWED_BRANCHES=main,master

# Secret partagé avec le webhook GitHub.
HOSTINATOR_GITHUB_WEBHOOK_SECRET=change-me

# Caddy installé directement sur la machine.
CADDYFILE=/etc/caddy/Caddyfile
CADDY_SITES_DIR=/etc/caddy/sites

# Ports localhost alloués aux apps Docker Compose derrière Caddy.
HOSTINATOR_PORT_START=18000
HOSTINATOR_PORT_END=18999
