# Domaine racine utilisé quand tu passes seulement un sous-domaine.
# Exemple: ./bin/site add api https://github.com/org/app.git -> api.example.com
BASE_DOMAIN=example.com

# Réseau Docker partagé entre Caddy et les apps déployées.
PROXY_NETWORK=caddy_proxy

# Nom du projet Docker Compose de cette stack Caddy.
CADDY_COMPOSE_PROJECT=caddy-router

# Ports publics.
HTTP_PORT=80
HTTPS_PORT=443
