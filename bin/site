#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT_DIR/.env"
APPS_DIR="${APPS_DIR:-$ROOT_DIR/apps}"
SITES_DIR="$ROOT_DIR/caddy/sites"
STATE_DIR="$ROOT_DIR/state"
STATE_FILE="$STATE_DIR/sites.tsv"

if [[ -f "$ENV_FILE" ]]; then
	set -a
	# shellcheck disable=SC1090
	. "$ENV_FILE"
	set +a
fi

BASE_DOMAIN="${BASE_DOMAIN:-}"
PROXY_NETWORK="${PROXY_NETWORK:-caddy_proxy}"
CADDY_COMPOSE_PROJECT="${CADDY_COMPOSE_PROJECT:-caddy-router}"

usage() {
	cat <<'EOF'
Usage:
  ./bin/site init
  ./bin/site add <sous-domaine|domaine> <repo-git> [options]
  ./bin/site add <repo-git> <sous-domaine|domaine> [options]
  ./bin/site update <sous-domaine|domaine>
  ./bin/site remove <sous-domaine|domaine>
  ./bin/site list

Options add:
  --branch <branche>       Branche Git à cloner/checkout
  --service <service>      Service Docker Compose à exposer
  --port <port>            Port interne du service
  --compose <fichier>      Fichier compose du repo, ex: docker-compose.prod.yml
  --build                  Force docker compose up --build

Exemples:
  ./bin/site init
  ./bin/site add api https://github.com/org/api.git --port 3000
  ./bin/site add https://github.com/org/site.git blog --service web --port 8080
EOF
}

log() {
	printf '[site] %s\n' "$*"
}

warn() {
	printf '[site] Attention: %s\n' "$*" >&2
}

die() {
	printf '[site] Erreur: %s\n' "$*" >&2
	exit 1
}

require_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "commande introuvable: $1"
}

require_runtime() {
	require_cmd docker
	require_cmd git
	docker compose version >/dev/null 2>&1 || die "Docker Compose v2 est requis: docker compose version"
}

caddy_compose() {
	local args=(docker compose)
	if [[ -f "$ENV_FILE" ]]; then
		args+=(--env-file "$ENV_FILE")
	fi
	args+=(-p "$CADDY_COMPOSE_PROJECT" -f "$ROOT_DIR/compose.yaml")
	"${args[@]}" "$@"
}

ensure_dirs() {
	mkdir -p "$APPS_DIR" "$SITES_DIR" "$STATE_DIR"
}

ensure_network() {
	if ! docker network inspect "$PROXY_NETWORK" >/dev/null 2>&1; then
		log "Création du réseau Docker $PROXY_NETWORK"
		docker network create "$PROXY_NETWORK" >/dev/null
	fi
}

ensure_caddy() {
	ensure_network
	log "Démarrage de Caddy"
	caddy_compose up -d caddy
}

reload_caddy() {
	ensure_caddy
	log "Rechargement de Caddy"
	caddy_compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
}

is_git_ref() {
	[[ "$1" == git@* || "$1" == ssh://* || "$1" == http://* || "$1" == https://* || "$1" == *.git ]]
}

validate_label() {
	local label="$1"
	[[ "$label" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]
}

validate_domain() {
	local domain="$1"
	[[ ${#domain} -le 253 ]] || return 1
	[[ "$domain" != *..* ]] || return 1
	IFS='.' read -r -a labels <<< "$domain"
	[[ ${#labels[@]} -ge 2 ]] || return 1
	local label
	for label in "${labels[@]}"; do
		validate_label "$label" || return 1
	done
}

domain_for() {
	local raw="${1,,}"
	raw="${raw%.}"
	if [[ "$raw" == *.* ]]; then
		validate_domain "$raw" || die "domaine invalide: $1"
		printf '%s\n' "$raw"
		return
	fi

	validate_label "$raw" || die "sous-domaine invalide: $1"
	[[ -n "$BASE_DOMAIN" ]] || die "BASE_DOMAIN est vide. Copie .env.example vers .env et configure ton domaine."
	local domain="$raw.${BASE_DOMAIN,,}"
	validate_domain "$domain" || die "domaine généré invalide: $domain"
	printf '%s\n' "$domain"
}

slug_for_domain() {
	local domain="$1"
	printf '%s\n' "site-${domain//./-}"
}

find_compose_file() {
	local app_dir="$1"
	local requested="${2:-}"
	local candidates=()

	if [[ -n "$requested" ]]; then
		candidates=("$requested")
	else
		candidates=(compose.yaml compose.yml docker-compose.yaml docker-compose.yml)
	fi

	local candidate
	for candidate in "${candidates[@]}"; do
		if [[ -f "$app_dir/$candidate" ]]; then
			printf '%s\n' "$app_dir/$candidate"
			return
		fi
	done

	if [[ -n "$requested" ]]; then
		die "fichier compose introuvable dans le repo: $requested"
	fi
	die "aucun compose.yaml/compose.yml/docker-compose.yaml/docker-compose.yml trouvé dans $app_dir"
}

app_compose_cmd() {
	local app_dir="$1"
	local project="$2"
	local compose_file="$3"
	shift 3
	docker compose -p "$project" --project-directory "$app_dir" -f "$compose_file" "$@"
}

select_service() {
	local app_dir="$1"
	local project="$2"
	local compose_file="$3"
	local requested="${4:-}"
	local services
	services="$(app_compose_cmd "$app_dir" "$project" "$compose_file" config --services)"

	if [[ -n "$requested" ]]; then
		grep -Fxq "$requested" <<< "$services" || die "service '$requested' absent du compose. Services: $(tr '\n' ' ' <<< "$services")"
		printf '%s\n' "$requested"
		return
	fi

	if grep -Fxq web <<< "$services"; then
		printf '%s\n' web
		return
	fi

	local count
	count="$(grep -cve '^[[:space:]]*$' <<< "$services" || true)"
	if [[ "$count" == "1" ]]; then
		printf '%s\n' "$services"
		return
	fi

	die "plusieurs services détectés ($(tr '\n' ' ' <<< "$services")). Ajoute --service <nom>."
}

container_is_on_network() {
	local cid="$1"
	docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$cid" | grep -Fxq "$PROXY_NETWORK"
}

connect_container_to_proxy() {
	local cid="$1"
	if container_is_on_network "$cid"; then
		return
	fi
	log "Connexion du conteneur au réseau $PROXY_NETWORK"
	docker network connect "$PROXY_NETWORK" "$cid"
}

container_name() {
	local cid="$1"
	docker inspect --format '{{.Name}}' "$cid" | sed 's#^/##'
}

infer_port() {
	local cid="$1"
	local port

	port="$(docker inspect --format '{{range $port, $_ := .Config.ExposedPorts}}{{println $port}}{{end}}' "$cid" 2>/dev/null | sed -n 's#/tcp$##p' | head -n 1)"
	if [[ -n "$port" ]]; then
		printf '%s\n' "$port"
		return
	fi

	port="$(docker inspect --format '{{range $port, $_ := .NetworkSettings.Ports}}{{println $port}}{{end}}' "$cid" 2>/dev/null | sed -n 's#/tcp$##p' | head -n 1)"
	if [[ -n "$port" ]]; then
		printf '%s\n' "$port"
		return
	fi
}

write_caddy_site() {
	local domain="$1"
	local upstream="$2"
	local port="$3"
	local site_file="$SITES_DIR/$domain.caddy"
	local tmp
	tmp="$(mktemp "$site_file.tmp.XXXXXX")"

	{
		printf '# Généré par ./bin/site. Les changements manuels peuvent être remplacés.\n'
		printf '%s {\n' "$domain"
		printf '\tencode zstd gzip\n'
		printf '\treverse_proxy %s:%s\n' "$upstream" "$port"
		printf '}\n'
	} > "$tmp"

	mv "$tmp" "$site_file"
}

save_state() {
	local domain="$1"
	local repo="$2"
	local app_dir="$3"
	local project="$4"
	local compose_file="$5"
	local service="$6"
	local port="$7"
	local compose_rel="${compose_file#$app_dir/}"
	local tmp

	touch "$STATE_FILE"
	tmp="$(mktemp "$STATE_FILE.tmp.XXXXXX")"
	grep -Fv "${domain}	" "$STATE_FILE" > "$tmp" || true
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$domain" "$repo" "$app_dir" "$project" "$compose_rel" "$service" "$port" >> "$tmp"
	mv "$tmp" "$STATE_FILE"
}

state_row_for_domain() {
	local domain="$1"
	[[ -f "$STATE_FILE" ]] || return 1
	awk -F '\t' -v domain="$domain" '$1 == domain { row = $0 } END { if (row) print row; else exit 1 }' "$STATE_FILE"
}

clone_or_pull() {
	local repo="$1"
	local app_dir="$2"
	local branch="${3:-}"

	if [[ -d "$app_dir/.git" ]]; then
		log "Pull Git dans $app_dir"
		git -C "$app_dir" fetch --all --prune
		if [[ -n "$branch" ]]; then
			git -C "$app_dir" checkout "$branch"
			git -C "$app_dir" pull --ff-only origin "$branch"
		else
			git -C "$app_dir" pull --ff-only
		fi
		return
	fi

	[[ ! -e "$app_dir" ]] || die "$app_dir existe déjà mais n'est pas un repo Git"
	log "Clone Git de $repo"
	if [[ -n "$branch" ]]; then
		git clone --branch "$branch" "$repo" "$app_dir"
	else
		git clone "$repo" "$app_dir"
	fi
}

deploy_site() {
	local domain="$1"
	local repo="$2"
	local branch="$3"
	local requested_service="$4"
	local requested_port="$5"
	local requested_compose="$6"
	local force_build="$7"

	local slug project app_dir compose_file service up_args cid upstream port
	slug="$(slug_for_domain "$domain")"
	project="$slug"
	app_dir="$APPS_DIR/$slug"

	ensure_dirs
	ensure_network
	clone_or_pull "$repo" "$app_dir" "$branch"

	compose_file="$(find_compose_file "$app_dir" "$requested_compose")"
	service="$(select_service "$app_dir" "$project" "$compose_file" "$requested_service")"

	log "Pull des images Docker du repo si disponibles"
	app_compose_cmd "$app_dir" "$project" "$compose_file" pull --ignore-pull-failures || true

	up_args=(up -d)
	if [[ "$force_build" == "1" ]]; then
		up_args+=(--build)
	fi

	log "Lancement du compose app: projet=$project service=$service"
	app_compose_cmd "$app_dir" "$project" "$compose_file" "${up_args[@]}"

	cid="$(app_compose_cmd "$app_dir" "$project" "$compose_file" ps -q "$service" | head -n 1)"
	[[ -n "$cid" ]] || die "impossible de trouver le conteneur du service $service"

	connect_container_to_proxy "$cid"
	upstream="$(container_name "$cid")"
	port="$requested_port"
	if [[ -z "$port" ]]; then
		port="$(infer_port "$cid" || true)"
	fi
	if [[ -z "$port" ]]; then
		port="80"
		warn "port interne non détecté pour $service, utilisation de 80. Relance avec --port <port> si besoin."
	fi
	[[ "$port" =~ ^[0-9]{1,5}$ ]] || die "port invalide: $port"

	write_caddy_site "$domain" "$upstream" "$port"
	save_state "$domain" "$repo" "$app_dir" "$project" "$compose_file" "$service" "$port"
	reload_caddy

	log "OK: https://$domain -> $upstream:$port"
}

cmd_init() {
	require_runtime
	ensure_dirs
	ensure_caddy
	log "OK: Caddy est lancé"
}

cmd_add() {
	require_runtime
	[[ $# -ge 2 ]] || die "add attend un sous-domaine/domaine et un repo Git"

	local first="$1"
	local second="$2"
	shift 2

	local raw_domain repo
	if is_git_ref "$first" && ! is_git_ref "$second"; then
		repo="$first"
		raw_domain="$second"
	else
		raw_domain="$first"
		repo="$second"
	fi

	local branch="" service="" port="" compose_file="" build="0"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--branch)
				branch="${2:-}"
				[[ -n "$branch" ]] || die "--branch attend une valeur"
				shift 2
				;;
			--service)
				service="${2:-}"
				[[ -n "$service" ]] || die "--service attend une valeur"
				shift 2
				;;
			--port)
				port="${2:-}"
				[[ -n "$port" ]] || die "--port attend une valeur"
				shift 2
				;;
			--compose)
				compose_file="${2:-}"
				[[ -n "$compose_file" ]] || die "--compose attend une valeur"
				shift 2
				;;
			--build)
				build="1"
				shift
				;;
			-h|--help)
				usage
				exit 0
				;;
			*)
				die "option inconnue: $1"
				;;
		esac
	done

	local domain
	domain="$(domain_for "$raw_domain")"
	deploy_site "$domain" "$repo" "$branch" "$service" "$port" "$compose_file" "$build"
}

cmd_update() {
	require_runtime
	[[ $# -eq 1 ]] || die "update attend un seul sous-domaine/domaine"
	local domain row repo app_dir project compose_rel service port
	domain="$(domain_for "$1")"
	row="$(state_row_for_domain "$domain")" || die "aucun état trouvé pour $domain. Utilise add d'abord."
	IFS=$'\t' read -r _ repo app_dir project compose_rel service port <<< "$row"
	deploy_site "$domain" "$repo" "" "$service" "$port" "$compose_rel" "0"
}

cmd_remove() {
	require_runtime
	[[ $# -eq 1 ]] || die "remove attend un seul sous-domaine/domaine"
	local domain row repo app_dir project compose_rel service port site_file tmp
	domain="$(domain_for "$1")"
	row="$(state_row_for_domain "$domain")" || die "aucun état trouvé pour $domain"
	IFS=$'\t' read -r _ repo app_dir project compose_rel service port <<< "$row"

	if [[ -f "$app_dir/$compose_rel" ]]; then
		log "Arrêt du compose app $project"
		app_compose_cmd "$app_dir" "$project" "$app_dir/$compose_rel" down || true
	fi

	site_file="$SITES_DIR/$domain.caddy"
	rm -f "$site_file"

	tmp="$(mktemp "$STATE_FILE.tmp.XXXXXX")"
	grep -Fv "${domain}	" "$STATE_FILE" > "$tmp" || true
	mv "$tmp" "$STATE_FILE"
	reload_caddy
	log "OK: $domain supprimé"
}

cmd_list() {
	if [[ ! -s "$STATE_FILE" ]]; then
		log "Aucun site enregistré"
		return
	fi
	printf 'DOMAIN\tREPO\tAPP_DIR\tPROJECT\tCOMPOSE\tSERVICE\tPORT\n'
	cat "$STATE_FILE"
}

main() {
	local cmd="${1:-}"
	if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
		usage
		exit 0
	fi
	shift

	case "$cmd" in
		init) cmd_init "$@" ;;
		add) cmd_add "$@" ;;
		update) cmd_update "$@" ;;
		remove|rm) cmd_remove "$@" ;;
		list|ls) cmd_list "$@" ;;
		*) die "commande inconnue: $cmd" ;;
	esac
}

main "$@"
